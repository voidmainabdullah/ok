# Genius AI Builder: configuration reference. Copy to `.env` for local development (`.env` is git-ignored).
# On Whop, secrets are added as app secrets (for example GROQ_API_KEY), not committed.

# ---------------------------------------------------------------------------------------------------------------------
# SECRET: server only. Never prefix these with VITE_ or NEXT_PUBLIC_ (those are shipped to the browser).
# ---------------------------------------------------------------------------------------------------------------------

# Groq API key. Without it Genius AI shows "not configured" and the CRM keeps working normally.
# Read only inside the server function; never sent to the client, never logged.
GROQ_API_KEY=

# Models. Defaults shown. FAST handles small changes and questions; STRONG handles new builds and repairs.
# GENIUS_MODEL_FAST=openai/gpt-oss-20b
# GENIUS_MODEL_STRONG=openai/gpt-oss-120b

# Capability flags. Normally derived from a built-in table of known models; set these only for a custom model id.
#   *_STRICT  = the model supports strict structured outputs (json_schema, strict: true)  -> true|false
#   *_CACHING = the provider reports prompt-cache hits for this model                      -> true|false
# GENIUS_MODEL_FAST_STRICT=true
# GENIUS_MODEL_FAST_CACHING=true
# GENIUS_MODEL_STRONG_STRICT=true
# GENIUS_MODEL_STRONG_CACHING=true

# Timeouts and retries (server). The base timeouts are 90s new build, 45s change, 60s repair, 20s question.
# Multiply them (for example 1.5 on a slow network). Range 0.1 - 5.
# GENIUS_TIMEOUT_SCALE=1
# Retries after a 429 / 5xx / network error / timeout (exponential backoff with jitter). Range 0 - 5.
# GENIUS_MAX_RETRIES=2

# ---------------------------------------------------------------------------------------------------------------------
# PUBLIC: Supabase email + password sign-in. The publishable key is safe in the browser; there is NO service-role key.
# Both naming styles are read; VITE_ wins when both are set. Defaults are built in (src/genius/supabaseConfig.ts).
# ---------------------------------------------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://oiffztqactqszxyjrqtj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BZkatwDc3m9x2OXvym3ZsA_cAEAt4xj
NEXT_PUBLIC_SUPABASE_URL=https://oiffztqactqszxyjrqtj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BZkatwDc3m9x2OXvym3ZsA_cAEAt4xj
